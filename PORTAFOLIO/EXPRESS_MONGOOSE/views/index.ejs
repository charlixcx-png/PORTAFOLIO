<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mongo DB - F1 Test</title>
    <link rel="stylesheet" href="/views/style.css" />
</head>
<body>
    <img src="/StarLion.png" alt="lion brewery" />
    <h1>Welcome to my F1 DB</h1>
    
    <form action="/driver" method="POST">
        <input type="text" name="number" placeholder="Number" required />
        <input type="text" name="code" placeholder="Code" required />
        <input type="text" name="forename" placeholder="Forename" required />
        <input type="text" name="surname" placeholder="surname" required />
        <input type="date" name="dob" placeholder="Day of birth" required />
        <input type="text" name="nationality" placeholder="Nationality" required />
        <input type="url" name="url" placeholder="URL" required />
        <select name="team" required>
            <option value="">Seleccione un equipo</option>
            <% teams.forEach(team => { %>
              <option value="<%= team.name %>"><%= team.name %></option>
            <% }) %>
            <option value="N/A">Sin equipo</option> 
          </select>
          
        <button type="submit">Add pilot</button>
      </form>
      
</body>
</html>
